# DeepSeek Web Client Configuration Example
# Copy this file to .env and configure your parameters.
# NEVER commit your actual .env file or credentials to source control!

# Option 1: Direct Token Authentication
# If you already have your Bearer token from chat.deepseek.com (from Developer Tools -> Application -> Local Storage -> userToken):
# DEEPSEEK_TOKEN=your_bearer_token_here

# Option 2: Browser-based Interactive Authentication (Playwright)
# If DEEPSEEK_TOKEN is not provided, the client will use Playwright to launch a browser session.
# The user can sign in interactively, complete any human-verification/CAPTCHA/MFA challenges,
# and the resulting session token and cookies will be saved automatically to DEEPSEEK_SESSION_FILE.
DEEPSEEK_SESSION_FILE=./session/session.json
DEEPSEEK_PROFILE_DIR=./session/profile
DEEPSEEK_BROWSER_HEADLESS=false

# Optional custom User-Agent (defaults to standard modern Chrome UA):
# DEEPSEEK_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36

# Optional cookies in JSON format (e.g. '{"sid": "..."}')
# DEEPSEEK_COOKIES={}

# Local OpenAI-Compatible Server Configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# Optional API key for authenticating requests to your local OpenAI-compatible endpoint
# (If unset, any API key or none will be accepted by the local server)
# SERVER_API_KEY=local-secret-key

# Rate limiting for local server (requests per minute)
SERVER_RATE_LIMIT=60
